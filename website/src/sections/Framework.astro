---
import Section from '../components/Section.astro';
import Math from '../components/Math.astro';
import PrivacySlider from '../components/visuals/PrivacySlider.astro';
import Pipeline from '../components/visuals/Pipeline.astro';

const compare = [
  { tool: 'Opacus', dp: true, fl: false, he: false, oss: true },
  { tool: 'TenSEAL', dp: false, fl: false, he: true, oss: true },
  { tool: 'PySyft', dp: false, fl: true, he: false, oss: true },
  { tool: 'Obscura DP (in development)', dp: true, fl: true, he: true, oss: true, us: true },
];
---

<Section id="framework" tone="surface" labelledBy="framework-title">
  <h2 id="framework-title">Three protections, one pipeline.</h2>

  <div class="guarantee">
    <div class="guarantee-copy">
      <p class="label">A. The guarantee</p>
      <p>
        Imagine running the same training job twice: once on a dataset that includes you, and once on an identical
        dataset without you. Differential privacy guarantees the two results are almost indistinguishable. So nobody
        looking at the output, including an attacker, can tell whether you were in the data, let alone what your
        record said.
      </p>
      <p class="bounded">
        This is a bounded guarantee, not an absolute one: the bound is a mathematical limit on how much any single
        person can change the result, and ε says exactly how tight it is.
      </p>
    </div>
    <div class="guarantee-math">
      <Math display tex={String.raw`\Pr[M(D_1) \in S] \;\le\; e^{\varepsilon}\,\Pr[M(D_2) \in S] + \delta`} />
      <dl class="legend">
        <div>
          <dt><Math tex="M" /></dt>
          <dd>is the analysis or training run.</dd>
        </div>
        <div>
          <dt><Math tex="D_1" /> and <Math tex="D_2" /></dt>
          <dd>are any two datasets that differ by one person.</dd>
        </div>
        <div>
          <dt><Math tex="S" /></dt>
          <dd>is any set of possible outputs.</dd>
        </div>
        <div>
          <dt>ε (epsilon), the privacy budget</dt>
          <dd>
            how far apart the two results are allowed to be. Lower ε means stronger privacy and more noise. Higher ε
            means less privacy and better accuracy.
          </dd>
        </div>
        <div>
          <dt>δ</dt>
          <dd>a tiny chance the bound doesn't hold. Our experiments use <Math tex="\delta = 10^{-5}" />.</dd>
        </div>
      </dl>
    </div>
  </div>

  <div class="dial-block">
    <p class="label">B. The privacy dial</p>
    <PrivacySlider />
    <p class="dial-text">
      One dial, set per use case. Hospital records can run below ε = 1 while lower-risk work, like training a
      language model, can allow more. With personalized ε, the most sensitive users get ε &lt; 1 and others can allow
      more for higher accuracy.
    </p>
  </div>

  <div class="protections">
    <p class="label">C. The three protections</p>
    <ul class="rows protection-rows">
      <li>
        <svg class="row-icon" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="5" cy="12" r="2.5"></circle><circle cx="19" cy="5" r="2.5"></circle><circle cx="19" cy="19" r="2.5"></circle>
          <path d="M7.3 10.9 16.7 6.1M7.3 13.1l9.4 4.8"></path>
        </svg>
        <div>
          <h3>Federated learning</h3>
          <p>
            The model goes to the data. Training happens on each device or at each site, and only model updates come
            back. We never receive raw data, so it can't be stolen from us or intercepted on the way.
          </p>
        </div>
      </li>
      <li>
        <svg class="row-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 12h18"></path><path d="M7 7l-3 5 3 5"></path><path d="M17 7l3 5-3 5"></path>
        </svg>
        <div>
          <h3>DP-SGD with calibrated noise</h3>
          <p>
            DP-SGD is the standard way to train a model with differential privacy. Each person's influence on every
            training step is capped, then precisely measured random noise is added. Privacy accounting tracks how much
            of the budget each training run spends.
          </p>
        </div>
      </li>
      <li>
        <svg class="row-icon" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="4" y="11" width="16" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path>
        </svg>
        <div>
          <h3>Homomorphic encryption (CKKS)</h3>
          <p>
            CKKS is an encryption scheme that can do arithmetic on encrypted decimal numbers. Updates are encrypted on
            the device. The server adds them together while they stay encrypted and never sees the unencrypted values.
          </p>
        </div>
      </li>
    </ul>
    <p class="together">
      <strong>Together:</strong> the data can't be read in transit, isn't sitting on our servers to steal, and the
      trained model reveals almost nothing about any one person, with ε setting exactly how little.
    </p>
  </div>

  <div class="pipeline-block">
    <p class="label">D. The pipeline</p>
    <Pipeline />
  </div>

  <div class="compare">
    <p class="label">E. How it compares</p>
    <div class="table-wrap">
      <table>
        <caption class="visually-hidden">Capabilities referenced for each tool</caption>
        <thead>
          <tr>
            <th scope="col">Tool</th>
            <th scope="col" class="center">Differential privacy</th>
            <th scope="col" class="center">Federated learning</th>
            <th scope="col" class="center">Homomorphic encryption</th>
            <th scope="col" class="center">Open source</th>
          </tr>
        </thead>
        <tbody>
          {
            compare.map((r) => (
              <tr class:list={{ us: r.us }}>
                <th scope="row">{r.tool}</th>
                {[r.dp, r.fl, r.he, r.oss].map((v) => (
                  <td class="center">
                    {v ? (
                      <>
                        <span class="dot" aria-hidden="true">●</span>
                        <span class="visually-hidden">yes</span>
                      </>
                    ) : (
                      <span class="visually-hidden">not referenced</span>
                    )}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="source">
      Dots mark each tool's referenced capabilities; a blank is not a claim that a tool lacks it. Obscura DP's
      integrated stack is in development.
    </p>
  </div>
</Section>

<style>
  h2 {
    max-width: 20ch;
  }
  .label {
    margin-bottom: var(--s-3);
  }
  .guarantee {
    margin-top: var(--s-6);
    display: grid;
    gap: var(--s-5);
  }
  .guarantee-copy {
    display: grid;
    gap: var(--s-2);
    align-content: start;
  }
  .guarantee-copy .label {
    margin-bottom: 0;
  }
  .bounded {
    color: var(--muted);
    font-size: var(--fs-body);
  }
  .guarantee-math {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--r-panel);
    padding: var(--s-3);
  }
  .legend {
    margin: var(--s-2) 0 0;
    display: grid;
    gap: var(--s-2);
    border-top: 1px solid var(--line);
    padding-top: var(--s-3);
  }
  .legend > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.25rem;
    font-size: var(--fs-body);
  }
  .legend dt {
    color: var(--ink);
    font-weight: 600;
  }
  .legend dd {
    margin: 0;
    color: var(--text);
  }
  .dial-block,
  .protections,
  .pipeline-block,
  .compare {
    margin-top: var(--s-12);
  }
  .dial-block :global(.dial) {
    background: var(--bg);
  }
  .dial-text {
    margin-top: var(--s-3);
  }
  .protection-rows li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--s-2);
  }
  .row-icon {
    width: 26px;
    height: 26px;
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    margin-top: 0.1rem;
  }
  .protection-rows h3 {
    margin-bottom: 0.375rem;
  }
  .together {
    margin-top: var(--s-4);
  }
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--r-panel);
    background: var(--bg);
  }
  table {
    min-width: 560px;
  }
  th.center,
  td.center {
    text-align: center;
  }
  .dot {
    color: var(--blue);
    font-size: 0.9rem;
  }
  tr.us th {
    color: var(--blue);
  }
  .compare .source {
    margin-top: var(--s-2);
  }
  @media (min-width: 900px) {
    .guarantee {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--s-8);
      align-items: start;
    }
    .legend > div {
      grid-template-columns: 12rem 1fr;
      gap: var(--s-2);
    }
  }
</style>
