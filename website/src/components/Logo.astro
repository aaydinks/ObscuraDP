---
// Logo with a text fallback. When the real raster logo is added at
// src/assets/brand/logo.png (and mark.png), it is used automatically.
import { Image } from 'astro:assets';
const logos = import.meta.glob<{ default: ImageMetadata }>('../assets/brand/logo.{png,webp}', { eager: true });
const marks = import.meta.glob<{ default: ImageMetadata }>('../assets/brand/mark.{png,webp}', { eager: true });
const logo = Object.values(logos)[0]?.default;
const mark = Object.values(marks)[0]?.default;

interface Props {
  variant?: 'full' | 'mark';
  height?: number;
  class?: string;
}
const { variant = 'full', height = 30, class: cls } = Astro.props;
const img = variant === 'mark' ? mark : logo;
---

{
  img ? (
    <Image
      src={img}
      alt={variant === 'mark' ? 'Obscura DP mark' : 'Obscura DP'}
      height={height}
      width={Math.round((img.width / img.height) * height)}
      densities={[1, 2]}
      class:list={['logo-img', cls]}
      style={`height:${height}px;width:auto`}
      loading="eager"
    />
  ) : variant === 'mark' ? (
    <svg
      class:list={['logo-mark', cls]}
      width={height}
      height={height}
      viewBox="0 0 32 32"
      aria-label="Obscura DP mark"
      role="img"
    >
      <circle cx="16" cy="16" r="13" fill="none" stroke="var(--blue)" stroke-width="2.5" />
      <path d="M16 7.5a8.5 8.5 0 0 1 0 17z" fill="var(--blue)" />
    </svg>
  ) : (
    <span class:list={['logo-text', cls]} style={`--logo-h:${height}px`}>
      <svg width={height} height={height} viewBox="0 0 32 32" aria-hidden="true">
        <circle cx="16" cy="16" r="13" fill="none" stroke="var(--blue)" stroke-width="2.5" />
        <path d="M16 7.5a8.5 8.5 0 0 1 0 17z" fill="var(--blue)" />
      </svg>
      <span>Obscura<b>DP</b></span>
    </span>
  )
}

<style>
  .logo-img {
    width: auto;
    flex: none;
    align-self: flex-start;
  }
  .logo-text {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: calc(var(--logo-h) * 0.72);
    letter-spacing: -0.01em;
    color: var(--ink);
    line-height: 1;
    white-space: nowrap;
  }
  .logo-text b {
    font-weight: 600;
    color: var(--blue);
  }
</style>
