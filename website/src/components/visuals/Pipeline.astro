---
// Five steps with a device/server boundary between steps 3 and 4.
const steps = [
  { title: 'Device data', text: 'Raw data stays on the device', icon: 'device' },
  { title: 'Clip + noise (DP-SGD)', text: "Each person's influence is bounded", icon: 'clip' },
  { title: 'Encrypt (CKKS)', text: 'Updates are encrypted', icon: 'lock' },
  { title: 'Server', text: 'Adds encrypted updates together', icon: 'server' },
  { title: 'Model update', text: 'The shared model learns, privately', icon: 'model' },
];
const icons: Record<string, string> = {
  device: '<rect x="5" y="3" width="14" height="18" rx="2"/><line x1="10" y1="18" x2="14" y2="18"/>',
  clip: '<path d="M4 12h16"/><path d="M8 6l-3 6 3 6"/><path d="M16 6l3 6-3 6"/>',
  lock: '<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>',
  server: '<rect x="4" y="4" width="16" height="7" rx="1.5"/><rect x="4" y="13" width="16" height="7" rx="1.5"/><line x1="8" y1="7.5" x2="8" y2="7.5"/><line x1="8" y1="16.5" x2="8" y2="16.5"/>',
  model: '<circle cx="6" cy="12" r="2"/><circle cx="18" cy="6" r="2"/><circle cx="18" cy="18" r="2"/><path d="M8 11l8-4M8 13l8 4"/>',
};
---

<div class="pipeline" role="list" aria-label="Pipeline steps">
  {
    steps.map((s, i) => (
      <>
        {i === 3 && (
          <div class="boundary" role="presentation">
            <span class="boundary-label">Your device | Server</span>
            <span class="boundary-note">Only noised, encrypted updates cross this line.</span>
          </div>
        )}
        <div class="step" role="listitem">
          <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
          <svg class="step-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[s.icon]} />
          <p class="step-title">{s.title}</p>
          <p class="step-text">{s.text}</p>
        </div>
      </>
    ))
  }
</div>

<style>
  .pipeline {
    display: grid;
    gap: var(--s-3);
    counter-reset: step;
  }
  .step {
    position: relative;
    padding: var(--s-3) 0 var(--s-3) 0;
    border-top: 1px solid var(--line);
  }
  .step-num {
    font-size: var(--fs-label);
    color: var(--muted);
  }
  .step-icon {
    width: 28px;
    height: 28px;
    margin: var(--s-1) 0 var(--s-2);
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .step-title {
    font-weight: 600;
    color: var(--ink);
    font-size: var(--fs-body);
  }
  .step-text {
    color: var(--muted);
    font-size: var(--fs-body);
    margin-top: 0.25rem;
  }
  .boundary {
    border-top: 1px dashed var(--blue);
    padding-top: var(--s-1);
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }
  .boundary-label {
    color: var(--blue);
    font-size: var(--fs-label);
  }
  .boundary-note {
    color: var(--muted);
    font-size: var(--fs-caption);
  }
  @media (min-width: 900px) {
    .pipeline {
      grid-template-columns: repeat(3, minmax(0, 1fr)) 28px repeat(2, minmax(0, 1fr));
      gap: var(--s-3);
      align-items: stretch;
    }
    .step {
      border-top: 1px solid var(--line);
    }
    .boundary {
      border-top: 0;
      border-left: 1px dashed var(--blue);
      padding: 0;
      position: relative;
      justify-self: center;
      width: 1px;
    }
    .boundary-label,
    .boundary-note {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      white-space: nowrap;
      background: inherit;
    }
    .boundary-label {
      top: -1.6rem;
    }
    .boundary-note {
      bottom: -1.6rem;
    }
  }
</style>
