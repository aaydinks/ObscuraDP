---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found · Obscura DP" description="That page does not exist." noindex path="/404">
  <section class="nf">
    <div class="wrap">
      <p class="label">404</p>
      <h1>There's nothing at this address.</h1>
      <p class="lede">The page may have moved, or the link may have a typo.</p>
      <div class="actions">
        <a href="/" class="btn btn-primary">Back to the home page</a>
        <a href="/research" class="arrow-link">Read the research</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    padding-block: var(--s-16) var(--s-16);
  }
  .nf h1 {
    max-width: 16ch;
    margin: var(--s-2) 0 var(--s-3);
  }
  .actions {
    margin-top: var(--s-5);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-3);
  }
</style>
